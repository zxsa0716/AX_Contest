# Copy this file to .env and fill in actual keys. Never commit .env.

# ─── VWorld Geocoder API 2.0 (국토교통부, 유일한 지오코더) ──────
# 발급: https://www.vworld.kr/v4po_oprn_s001.do (이메일 인증 후 즉시, 무료 40,000건/일)
# 국토교통부 공식 — 공모전 "국가중점데이터 활용" 가점 대상
# WGS84(EPSG:4326) 직접 반환, 도로명/지번 주소 모두 지원
VWORLD_API_KEY=

# ─── DART Open API (금융감독원 재무·공시) ─────────
# 발급: https://opendart.fss.or.kr → 인증키 신청
DART_API_KEY=

# ─── Google Earth Engine ─────────────────────────
# 서비스 계정 JSON 경로 (절대경로 권장)
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT_ID=

# ─── 공공데이터포털 (필요 시) ────────────────────
# https://www.data.go.kr → 마이페이지 → 인증키
DATA_GO_KR_KEY=

# ─── KMA (기상청) Open API Hub ───────────────────
# 발급: https://data.kma.go.kr (무료, 개인 20,000/일)
# 용도: ASOS 종관기상관측 — ERA5 재분석 지상 검증
KMA_API_KEY_ENCODED=
KMA_API_KEY_DECODED=

# ─── 선택: Notion MCP 사용 시 ────────────────────
NOTION_DATABASE_ID=
