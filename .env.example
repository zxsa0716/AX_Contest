# Copy this file to .env and fill in actual keys. Never commit .env.

# ─── Kakao Local API (주소 → 위경도 지오코딩) ──────
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=

# ─── DART Open API (금융감독원 재무·공시) ─────────
# 발급: https://opendart.fss.or.kr → 인증키 신청
DART_API_KEY=

# ─── Google Earth Engine ─────────────────────────
# 서비스 계정 JSON 경로 (절대경로 권장)
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT_ID=

# ─── 공공데이터포털 (필요 시) ────────────────────
# https://www.data.go.kr → 마이페이지 → 인증키
DATA_GO_KR_KEY=

# ─── 선택: Notion MCP 사용 시 ────────────────────
NOTION_DATABASE_ID=
