data/raw/
data/interim/
data/processed/
*.csv
*.xlsx
*.parquet
*.pkl
*.h5
*.nc
*.tif

# ─── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.conda/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Notebooks outputs ────────────────────────
